# GovGuard MY — example environment. COPY to `.env` for local use.
# NEVER commit a real .env. Placeholder names only; no real values here.
# The public judging build runs fully with the defaults below and NO keys.

# --- Defaults that make the build run with zero secrets ---
TEOW_AGL_PLANNER=smart_mock          # offline deterministic planner (no API key)
MAIC_DEMO_MODE=1                     # external actions simulated; nothing real is sent
TEOW_AGL_DOMAIN_PACK=public_school   # flagship domain pack

# --- Optional server knobs ---
# TEOW_AGL_HOST=127.0.0.1
# TEOW_AGL_PORT=8765
# TEOW_AGL_AUTH_PASSWORD=            # set to require a login on the hosted demo

# --- Optional LLM providers (OFF by default; opt-in only) ---
# Leave blank for the judging build. Fill ONLY in a private local .env.
# TEOW_AGL_PLANNER=groq|gemini|ollama|openai|deepseek|anthropic
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Mixed Live competition mode: keep the core deterministic, run Route A/B and
# their free-form follow-ups on the configured provider, and accept NEW
# school-domain cases.
# TEOW_AGL_LIVE_WORKFLOWS=ad_hoc_school_event_reporting,school_charity_bazaar
# TEOW_AGL_LIVE_SCHOOL_INPUTS=1
#
# OpenAI example:
# OPENAI_API_KEY=<private key; never commit it>
# OPENAI_MODEL=gpt-4o
#
# DeepSeek OpenAI-compatible example (the familiar OPENAI_* names are valid):
# OPENAI_API_KEY=<private DeepSeek key; never commit it>
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash
# DEEPSEEK_THINKING=disabled
#
# Optional explicit aliases (use these instead of OPENAI_API_KEY / MODEL if
# preferred; TEOW_AGL_LIVE_PROVIDER removes any inference ambiguity):
# TEOW_AGL_LIVE_PROVIDER=deepseek
# DEEPSEEK_API_KEY=<private DeepSeek key; never commit it>
# DEEPSEEK_MODEL=deepseek-v4-flash
#
# No provider-to-provider fallback exists. A failed DeepSeek call falls back to
# deterministic governed Markdown, never to OpenAI. In DeepSeek mode the chat
# key is also never reused for OpenAI embeddings. To opt in to OpenAI embeddings
# separately, provide OPENAI_EMBED_API_KEY.
# TEOW_AGL_PLANNER_MAX_TOKENS=2000
# OPENAI_EMBED_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_MODEL=qwen2.5-coder:7b
