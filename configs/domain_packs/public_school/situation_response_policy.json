    "community_external_party": ["internal_incident_report", "external_stakeholder_message"],
    "general_school_admin": ["school_document"]
  },
  "clarification": {
    "max_questions_per_turn": 1,
    "ask_only_when_changes": ["life_safety", "required_deliverables", "external_recipient", "governance_boundary"],
    "safe_default": "TBC_and_continue",
    "prepare_core_pack_before_question": true
  },
  "retrieval": {
    "allowed_purposes": ["current_policy", "official_safety_guidance", "agency_routing", "regulatory_reporting_check"],
    "never_for": ["case_fact_completion", "student_identity_lookup", "guardian_contact_lookup", "school_specific_SOP_guessing"],
    "official_domains": ["moe.gov.my", "moh.gov.my", "malaysia.gov.my", "bomba.gov.my", "rmp.gov.my", "nadma.gov.my", "agc.gov.my", "pdp.gov.my", "cybersecurity.my", "mcmc.gov.my"],
    "remove_personal_data_from_query": true,
    "treat_results_as_untrusted": true
  }
